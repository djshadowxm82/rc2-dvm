FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG TARGETRID=linux-arm64
WORKDIR /src

# Copy full solution context to resolve project references.
COPY . /src
WORKDIR /src/rc2-dvm
RUN dotnet restore rc2-dvm.csproj -r ${TARGETRID}
RUN dotnet publish rc2-dvm.csproj -c Release -r ${TARGETRID} --self-contained true -p:PublishSingleFile=true -o /out

FROM mcr.microsoft.com/dotnet/runtime-deps:8.0-bookworm-slim AS runtime
WORKDIR /app

# Native runtime dependency used by libvocoder.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/ /app/
COPY rc2-dvm/config.example.yml /app/config.example.yml

# Runtime mounts:
# - /config/config.yml
# - /config/keyFile.yml (optional)
# - /native/libvocoder.so
# - /logs
ENV LD_LIBRARY_PATH=/native:/app
ENTRYPOINT ["/app/rc2-dvm", "--config", "/config/config.yml"]
